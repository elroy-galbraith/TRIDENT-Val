server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        # No Host override: Cloud Run's front end routes by the backend's own
        # hostname, and forwarding the frontend's Host here breaks that routing.
        # SNI is required since the backend is plain HTTPS behind that same front end.
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { try_files $uri /index.html; }
}

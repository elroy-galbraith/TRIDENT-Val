# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored — never commit it.

project_id        = "your-gcp-project-id"
region             = "us-central1"
github_repository  = "elroy-galbraith/trident-val"

# Optional — leave blank to deploy with the AI copilot / AI-drafted report
# narrative disabled; both degrade gracefully (see .env.example at repo root).
# copilot_provider_api_key    = ""
# report_llm_provider_api_key = ""

# Optional — leave billing_account_id blank to skip budget alerts and the billing
# export BigQuery dataset entirely. See docs/deployment.md "Cost & FinOps".
# billing_account_id              = "XXXXXX-XXXXXX-XXXXXX"
# budget_amount                   = 50
# budget_alert_emails             = ["you@example.com"]
# billing_export_dataset_location = "US"

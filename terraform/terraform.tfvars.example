# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored — never commit it.

project_id        = "ats-avm-jam"
region            = "us-central1"
github_repository = "elroy-galbraith/trident-val"

# Both Cloud Run services are PUBLIC by default, matching the existing TRIDENT-Val
# deployment (explicit owner decision, ADR 0020). false requires IAM auth, which the
# frontend's nginx proxy cannot satisfy without extra service-to-service auth work.
# allow_unauthenticated = true

# Read-only /listings explorer access to BigQuery ats-avm-jam.listings_raw.
# grant_listings_access = true
# listings_dataset_id   = "listings_raw"

# Non-secret backend env for the explorer.
# backend_extra_env = {}

# Optional — blank = AI copilot / AI-drafted report narrative disabled.
# copilot_provider_api_key    = ""
# report_llm_provider_api_key = ""

# Copy to .env and fill in a real key. Docker Compose loads this automatically;
# the backend also loads it directly via python-dotenv for non-Docker runs.

# Required to enable the AI copilot. Leave unset and the copilot proxy returns
# 503 (the frontend widget stays mounted but inert) — everything else in the
# app works fine without it.
COPILOT_PROVIDER_API_KEY=

# OpenAI-compatible endpoint for the copilot's LLM calls. Defaults to Gemini's
# OpenAI-compat endpoint. Swap for Anthropic's OpenAI-compatible endpoint,
# OpenAI itself, etc.
# COPILOT_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Model to use behind the proxy. The browser can never override this.
# COPILOT_MODEL=gemini-2.5-flash

# Required to enable AI-drafted narrative sections (variance commentary, champion/challenger
# disagreement explanation, underwriter notes synthesis, limitations-in-context) in exported
# PDF reports (Underwriter Decision Report / Portfolio Review Summary — see backend/app/reports.py
# and backend/app/narrative.py). Leave unset and reports still generate in full — the
# AI-drafted sections just render a clearly-labeled placeholder instead of prose; every figure
# they would reference is already in the report's structured data. Get a key at openrouter.ai.
REPORT_LLM_PROVIDER_API_KEY=

# OpenRouter is used so the drafting model can be swapped by config alone — it's an
# OpenAI-compatible aggregator in front of many providers, not tied to one vendor's endpoint.
# REPORT_LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# Drafting model, addressed by its OpenRouter slug. Defaults to Gemini 2.5 Flash.
# REPORT_LLM_MODEL=google/gemini-2.5-flash

# Document Intake's Docling+LLM extraction (backend/app/extraction.py) reuses the three
# REPORT_LLM_* variables above by default, so one LLM key covers both features. Set these
# only if extraction should use a different provider/model than report narration. Unlike
# REPORT_LLM_*, an unset key here means extraction has nothing to run (no cosmetic fallback
# — see README's Document Intake section).
# EXTRACTION_LLM_PROVIDER_API_KEY=
# EXTRACTION_LLM_PROVIDER_BASE_URL=
# EXTRACTION_LLM_MODEL=

# Where the Data Ingestion tab's valuation_vendor dlt source pulls its mock paginated JSON
# feed from (see vendor_api/ and README's Data Ingestion section). Docker Compose sets this
# to http://vendor-api:8001 automatically; only needed locally if vendor_api runs on a
# non-default port.
# VENDOR_API_BASE_URL=http://localhost:8001

# Only needed if you want to override the default Postgres (Docker) /
# SQLite (local) connection string.
# DATABASE_URL=

# Signs the login session cookie (see backend/app/auth.py). Unset falls back to a
# known, non-secret PoC placeholder (fine for local/demo use) with a startup
# warning logged. Rotate to a real random value before any shared/non-local use:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=

# Marks the session cookie Secure (HTTPS-only) when set to "true". Defaults to false
# so login still works over plain http://localhost. Set to true once this runs behind
# real HTTPS — over plain HTTP the browser would silently refuse to send the cookie.
# SESSION_COOKIE_SECURE=
